---
import BaseLayout from '../layouts/BaseLayout.astro';
import { homeDiscoverySongs } from '../data/homeDiscovery';
import { getSortedReleases } from '../utils/musicCatalogue';
import { getMainCatalogueReleases } from '../utils/musicVisibility';
import { resolveMusicCover } from '../utils/musicCover';
import type { ResolvedMusicRelease } from '../utils/musicCatalogue';

const withBase = (path: string) => {
  const base = import.meta.env.BASE_URL.endsWith('/')
    ? import.meta.env.BASE_URL
    : `${import.meta.env.BASE_URL}/`;
  return `${base}${path.replace(/^\/+/, '')}`;
};

const releases = getSortedReleases();
const mainReleases = getMainCatalogueReleases(releases);
const today = new Date().toISOString().slice(0, 10);
const currentRelease =
  mainReleases.find((release) => release.releaseDate <= today) ??
  mainReleases[0] ??
  releases[0];

if (!currentRelease) throw new Error('Music catalogue is empty.');

const pickPlay = (release: ResolvedMusicRelease) => {
  const preferred = release.platforms.find((platform) =>
    /youtube|spotify|apple music|niconico|soundcloud|bilibili/i.test(platform.label)
  );
  return preferred
    ? { href: preferred.href, external: true }
    : { href: withBase(`/music/${release.slug}/`), external: false };
};

const heroSongs = homeDiscoverySongs.flatMap((spec) => {
  const release = releases.find((item) => item.slug === spec.slug);
  if (!release) return [];
  return [{
    spec,
    release,
    cover: resolveMusicCover(release, import.meta.env.BASE_URL),
    play: pickPlay(release)
  }];
});

const currentCover = resolveMusicCover(currentRelease, import.meta.env.BASE_URL);
const currentPlay = pickPlay(currentRelease);
---
<BaseLayout
  description="Misaka Sarina — independent music producer and digital creator building songs, archives, and small worlds on the internet."
>
  <section class="section hero">
    <div class="hero-copy">
      <p class="eyebrow" data-i18n="brandHome.eyebrow">Independent music producer & digital creator</p>
      <h1>Misaka Sarina</h1>
      <p class="tagline" data-i18n="brandHome.tagline">Songs, memories, and small worlds on the internet.</p>
      <p class="copy" data-i18n="brandHome.intro">Misaka Sarina makes music with virtual singers and keeps the surrounding stories, traces, and small digital worlds from disappearing.</p>
      <div class="button-row hero-actions">
        <a class="button primary" href="#start-here" data-i18n="brandHome.listen">Listen</a>
        <a class="button" href={withBase('/archive/')} data-i18n="brandHome.enterArchive">Enter the Archive</a>
      </div>
    </div>
    <aside class="card hero-signal" aria-label="Misaka Sarina brand signal">
      <div class="orb">MS</div>
      <span>NIGHT / MEMORY / ARCHIVE</span>
      <strong>cute × nostalgic × digital × lonely × warm</strong>
      <small>also known as Baker Siacone</small>
    </aside>
  </section>

  <section class="section meta-notice" role="note" aria-labelledby="meta-platform-notice-title">
    <span aria-hidden="true">!</span>
    <div>
      <strong id="meta-platform-notice-title" data-i18n="home.metaNoticeTitle">Meta platform use suspended</strong>
      <p data-i18n="home.metaNoticeBody">Because all of MISAKA SARINA's Meta accounts have been suspended, and after considering the future direction of this personal project, Meta platforms will no longer be used for the foreseeable future. Thank you for your understanding.</p>
    </div>
  </section>

  <section class="section discovery" id="start-here">
    <div class="section-heading">
      <div>
        <p class="eyebrow" data-i18n="brandHome.startEyebrow">Start here</p>
        <h2 data-i18n="brandHome.startTitle">Four songs. Four ways into the world.</h2>
      </div>
      <p data-i18n="brandHome.startCopy">This is the discovery layer: a small set of songs chosen for different roles, not a ranking of the whole catalogue.</p>
    </div>

    <div class="discovery-grid">
      {heroSongs.map(({ spec, release, cover, play }, index) => (
        <article class="card discovery-card">
          <div class="song-cover" aria-hidden="true">
            {cover.primary ? (
              <img src={cover.primary} data-cover-fallback data-fallback-src={cover.fallback} data-cover-strategy={cover.strategy} alt="" />
            ) : <span>MS</span>}
          </div>
          <div class="song-copy">
            <span class="song-index">{String(index + 1).padStart(2, '0')} · {spec.role}</span>
            <h3>{release.title}</h3>
            <p data-i18n={spec.storyKey}>{spec.fallbackStory}</p>
            <div class="button-row">
              <a class="button primary" href={play.href} target={play.external ? '_blank' : undefined} rel={play.external ? 'noreferrer' : undefined} data-i18n="brandHome.play">Play</a>
              <a class="button" href={withBase(`/music/${release.slug}/`)} data-i18n="brandHome.openEntry">Open archive entry</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section current-transmission">
    <div class="section-heading">
      <div>
        <p class="eyebrow" data-i18n="brandHome.currentEyebrow">Current transmission</p>
        <h2 data-i18n="brandHome.currentTitle">The newest story in the archive.</h2>
      </div>
      <p data-i18n="brandHome.currentCopy">This slot is generated from the newest main catalogue release available at build time, so the homepage does not get stuck on an old manual feature.</p>
    </div>

    <div class="current-grid">
      <article class="card current-release">
        <div class="current-cover" aria-hidden="true">
          {currentCover.primary ? (
            <img src={currentCover.primary} data-cover-fallback data-fallback-src={currentCover.fallback} data-cover-strategy={currentCover.strategy} alt="" />
          ) : <span>MS</span>}
        </div>
        <div>
          <p class="eyebrow">{currentRelease.type} · {currentRelease.releaseDate}</p>
          <h3>{currentRelease.title}</h3>
          <p>{currentRelease.description}</p>
          <div class="button-row">
            <a class="button primary" href={withBase(`/music/${currentRelease.slug}/`)} data-i18n="brandHome.viewRelease">Open current release</a>
            <a class="button" href={currentPlay.href} target={currentPlay.external ? '_blank' : undefined} rel={currentPlay.external ? 'noreferrer' : undefined} data-i18n="brandHome.play">Play</a>
          </div>
        </div>
      </article>

      <article class="card current-video">
        <p class="eyebrow" data-i18n="brandHome.featuredVideo">Featured video</p>
        <div class="video-frame">
          <iframe
            width="560"
            height="315"
            src="https://www.youtube.com/embed/-ZseniKo-2s"
            title="Misaka Sarina featured video"
            frameborder="0"
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
            loading="lazy"
          ></iframe>
        </div>
        <a class="button" href="https://youtu.be/-ZseniKo-2s?si=q5HjSG0nBWpqnLyq" target="_blank" rel="noreferrer" data-i18n="brandHome.watchVideo">Watch on YouTube</a>
      </article>
    </div>
  </section>

  <section class="section archive-entry">
    <div class="section-heading">
      <div>
        <p class="eyebrow" data-i18n="brandHome.archiveEyebrow">Enter the Archive</p>
        <h2 data-i18n="brandHome.archiveTitle">Go deeper without putting the whole database on the homepage.</h2>
      </div>
    </div>
    <div class="archive-grid">
      <a class="card route-card" href={withBase('/music/')}>
        <span>01</span><h3 data-i18n="brandHome.musicArchive">Music Archive</h3><p data-i18n="brandHome.musicArchiveCopy">The complete catalogue: main releases, versions, profiles, lyrics, and source metadata.</p>
      </a>
      <a class="card route-card" href={withBase('/blog/')}>
        <span>02</span><h3 data-i18n="brandHome.stories">Stories</h3><p data-i18n="brandHome.storiesCopy">Song context, diaries, notes, and the human reasons behind the archive.</p>
      </a>
      <a class="card route-card" href={withBase('/archive/')}>
        <span>03</span><h3 data-i18n="brandHome.artifacts">Artifacts</h3><p data-i18n="brandHome.artifactsCopy">Tools, downloads, experiments, project traces, and the digital garden.</p>
      </a>
    </div>
  </section>

  <section class="section about-stay-grid">
    <article class="card about-sarina">
      <p class="eyebrow" data-i18n="brandHome.aboutEyebrow">About Sarina</p>
      <h2 data-i18n="brandHome.aboutTitle">The person behind the archive.</h2>
      <p data-i18n="brandHome.aboutCopy">Misaka Sarina is an independent music producer and digital creator. VOCALOID and virtual singers are recurring instruments, but the larger project is about songs, memory, night, archives, and small worlds left on the internet. Baker Siacone remains the creator and legacy identity behind the project.</p>
      <a class="button" href={withBase('/about/')} data-i18n="brandHome.readStory">Read the full story</a>
    </article>

    <article class="card stay-card">
      <p class="eyebrow" data-i18n="brandHome.stayEyebrow">Join the Archive</p>
      <h2 data-i18n="brandHome.stayTitle">Receive transmissions.</h2>
      <p data-i18n="brandHome.stayCopy">Email transmissions are still being prepared. RSS is the stable owned channel today, so you can follow new notes without relying on a social platform.</p>
      <a class="button primary" href={withBase('/rss.xml')} data-i18n="brandHome.followRss">Follow RSS</a>
    </article>
  </section>

  <section class="section card support-strip">
    <div>
      <p class="eyebrow" data-i18n="brandHome.supportEyebrow">Support</p>
      <h2 data-i18n="brandHome.supportTitle">Support Sarina.</h2>
      <p data-i18n="brandHome.supportCopy">One support page, then choose the route that fits you. The homepage does not need to expose the payment infrastructure.</p>
    </div>
    <a class="button primary" href={withBase('/support/')} data-i18n="brandHome.supportCta">Support Sarina</a>
  </section>

  <script src={withBase('/meta-notice-i18n.js')} defer></script>
</BaseLayout>

<style>
  .hero { display: grid; grid-template-columns: minmax(0,1.2fr) minmax(280px,.58fr); gap: 30px; align-items: center; margin-top: 62px; }
  h1 { margin: 0; font-size: clamp(4.5rem,12vw,10rem); line-height: .82; letter-spacing: -.11em; text-shadow: 0 18px 70px rgba(0,0,0,.55); }
  .tagline { max-width: 820px; margin: 22px 0 10px; color: var(--text); font-size: clamp(1.5rem,3.5vw,2.6rem); font-weight: 850; line-height: 1.05; letter-spacing: -.055em; }
  .hero-copy .copy { max-width: 700px; }
  .hero-actions { margin-top: 28px; }
  .hero-signal { display: grid; gap: 18px; padding: 28px; }
  .hero-signal > span,.hero-signal small,.song-index { color: var(--soft); font-size: .72rem; font-weight: 850; letter-spacing: .14em; text-transform: uppercase; }
  .hero-signal strong { color: var(--accent); line-height: 1.5; }
  .orb { display: grid; place-items: center; width: 154px; height: 154px; border: 1px solid rgba(236,238,255,.3); border-radius: 32px; color: #080914; font-size: 3.5rem; font-weight: 950; letter-spacing: -.12em; background: linear-gradient(135deg,#f5f2ff,#aebcff 58%,#d7b4c7); box-shadow: 0 24px 90px rgba(0,0,0,.46); }

  .meta-notice { display: grid; grid-template-columns: auto minmax(0,1fr); gap: 14px; align-items: start; border: 1px solid rgba(255,190,202,.2); border-radius: 20px; background: rgba(49,22,35,.34); padding: 18px 20px; }
  .meta-notice > span { display: grid; place-items: center; width: 34px; height: 34px; border: 1px solid rgba(255,190,202,.28); border-radius: 11px; color: #ffd1da; font-weight: 950; }
  .meta-notice strong { color: var(--text); }
  .meta-notice p { margin: 5px 0 0; color: var(--soft); line-height: 1.55; font-size: .92rem; }

  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 28px; margin-bottom: 24px; }
  .section-heading h2,.about-sarina h2,.stay-card h2,.support-strip h2 { margin: 0; font-size: clamp(2.2rem,5vw,4.4rem); line-height: .92; letter-spacing: -.075em; }
  .section-heading > p { max-width: 420px; margin: 0; color: var(--muted); line-height: 1.65; }

  .discovery-grid { display: grid; gap: 16px; }
  .discovery-card { display: grid; grid-template-columns: 190px minmax(0,1fr); gap: 24px; align-items: center; padding: 20px; }
  .song-cover,.current-cover { overflow: hidden; aspect-ratio: 1; border: 1px solid rgba(236,238,255,.16); border-radius: 20px; background: linear-gradient(135deg,#f5f2ff,#aebcff 58%,#d7b4c7); }
  .song-cover img,.current-cover img { width: 100%; height: 100%; object-fit: cover; }
  .song-cover span,.current-cover span { display: grid; place-items: center; width: 100%; height: 100%; color: #080914; font-size: 2.8rem; font-weight: 950; }
  .song-copy h3,.current-release h3 { margin: 8px 0 10px; font-size: clamp(1.9rem,4vw,3.2rem); line-height: .95; letter-spacing: -.065em; }
  .song-copy > p,.current-release > div > p:not(.eyebrow) { margin: 0 0 18px; color: var(--muted); line-height: 1.68; }

  .current-grid { display: grid; grid-template-columns: minmax(0,1.2fr) minmax(320px,.8fr); gap: 18px; }
  .current-release { display: grid; grid-template-columns: minmax(180px,260px) minmax(0,1fr); gap: 24px; align-items: center; padding: 24px; }
  .current-video { display: grid; align-content: start; gap: 16px; padding: 22px; }
  .video-frame { position: relative; overflow: hidden; width: 100%; aspect-ratio: 16/9; border-radius: 18px; background: #000; }
  .video-frame iframe { position: absolute; inset: 0; width: 100%; height: 100%; }

  .archive-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: 16px; }
  .route-card { display: grid; min-height: 260px; gap: 12px; padding: 24px; transition: transform 160ms ease,border-color 160ms ease,background 160ms ease; }
  .route-card:hover,.route-card:focus-visible { transform: translateY(-3px); border-color: rgba(217,210,255,.45); background: rgba(19,22,42,.72); }
  .route-card span { color: var(--accent-2); font-size: .72rem; font-weight: 900; letter-spacing: .16em; }
  .route-card h3 { margin: auto 0 0; font-size: clamp(2rem,4vw,3rem); letter-spacing: -.06em; }
  .route-card p { margin: 0; color: var(--muted); line-height: 1.65; }

  .about-stay-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .about-sarina,.stay-card { display: flex; min-height: 340px; flex-direction: column; align-items: flex-start; padding: clamp(26px,5vw,40px); }
  .about-sarina > p:not(.eyebrow),.stay-card > p:not(.eyebrow),.support-strip p { color: var(--muted); line-height: 1.72; }
  .about-sarina .button,.stay-card .button { margin-top: auto; }

  .support-strip { display: grid; grid-template-columns: minmax(0,1fr) auto; gap: 24px; align-items: center; padding: clamp(26px,5vw,40px); margin-bottom: 24px; }
  .support-strip p { max-width: 760px; margin-bottom: 0; }

  :global(:root[data-theme='light']) .meta-notice { border-color: rgba(197,107,152,.22); background: rgba(255,247,250,.82); }
  :global(:root[data-theme='light']) .meta-notice > span { color: #9c426e; border-color: rgba(197,107,152,.28); }

  @media (max-width: 980px) {
    .hero,.current-grid,.about-stay-grid { grid-template-columns: 1fr; }
    .archive-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 780px) {
    .section-heading { align-items: flex-start; flex-direction: column; }
    .discovery-card,.current-release { grid-template-columns: 1fr; }
    .song-cover { max-width: 240px; }
    .current-cover { max-width: 300px; }
    .support-strip { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .meta-notice { grid-template-columns: 1fr; }
    .hero { margin-top: 34px; }
  }
</style>
