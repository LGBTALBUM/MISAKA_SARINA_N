---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout title="Bluesky Feed" description="Recent Bluesky posts loaded through the public API with a Worker fallback.">
  <link rel="stylesheet" href="/bsky-feed.css?v=card-style-1" />
  <section class="section card bsky-hero">
    <p class="eyebrow" data-i18n="bluesky.eyebrow">Bluesky Feed</p>
    <h1 class="title" data-i18n="bluesky.title">Short social stream.</h1>
    <p class="copy" data-i18n="bluesky.copy">Recent posts load from the Bluesky public API, with the site Worker kept as an automatic fallback.</p>
    <p data-bluesky-status data-i18n="bluesky.loading">Loading feed...</p>
    <div class="button-row">
      <a class="button primary" href="https://public.api.bsky.app/xrpc/app.bsky.feed.getAuthorFeed?actor=msarina.bluesky.siacone.art&amp;limit=12&amp;filter=posts_no_replies" target="_blank" rel="noreferrer" data-i18n="bluesky.openJson">Open source JSON</a>
      <a class="button" href="https://bsky.app/profile/msarina.bluesky.siacone.art" target="_blank" rel="noreferrer" data-i18n="bluesky.openProfile">Open Bluesky</a>
      <a class="button" href="/blog/" data-i18n="blog.backBlog">Back to blog</a>
    </div>
  </section>
  <section class="section bsky-list" data-bluesky-feed>
    <article class="bsky-card"><p data-i18n="bluesky.loadingCopy">Loading recent posts...</p></article>
  </section>
  <script src="/bsky-feed.js?v=api-fallback-1" defer></script>
</BaseLayout>
